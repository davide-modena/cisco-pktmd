// Tre router collegati in serie (cavi seriali) con RIP e una LAN a ciascun estremo.
// Il primo nome di un collegamento seriale e' il lato DCE (quello che da' il clock).

r1: router 2911
  module serial                     // scheda HWIC-2T: porte se0/0/0 e se0/0/1
  gi0/0 192.168.1.254/24
  se0/0/0 10.0.0.1/30
  rip passive gi0/0                 // non annunciare RIP verso la LAN

r2: router 2911
  module serial
  module serial
  se0/0/0 10.0.0.2/30
  se0/1/0 10.0.1.1/30
  rip

r3: router 2911
  module serial
  gi0/0 192.168.2.254/24
  se0/0/0 10.0.1.2/30
  rip passive gi0/0

pc1:
  ip 192.168.1.1/24
  gw 192.168.1.254

pc2:
  ip 192.168.2.1/24
  gw 192.168.2.254

sw1:
sw2:

links:
  pc1 sw1
  sw1 r1
  r1.se0/0/0 r2.se0/0/0
  r2.se0/1/0 r3.se0/0/0
  r3 sw2
  sw2 pc2
