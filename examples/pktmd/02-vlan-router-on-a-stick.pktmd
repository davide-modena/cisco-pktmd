// Due VLAN su uno switch e un router che le collega (router-on-a-stick).
// Niente CLI: le VLAN si scrivono sui collegamenti e le sottointerfacce sono righe di porta.

sw1:
  vlan 10 rosso
  vlan 20 blu
  fa0/10-24 access 99 down       // porte non usate: in una VLAN "buco nero" e spente

pc1:
  ip 192.168.10.1/24
  gw 192.168.10.254

pc2:
  ip 192.168.20.1/24
  gw 192.168.20.254

r1:
  gi0/0 vlan 10 192.168.10.254/24     // sottointerfaccia gi0/0.10 con dot1Q 10
  gi0/0 vlan 20 192.168.20.254/24     // sottointerfaccia gi0/0.20 con dot1Q 20

links:
  pc1 sw1 vlan 10                     // porta access in VLAN 10
  pc2 sw1 vlan 20
  sw1 r1 trunk 10,20                  // porta trunk (solo VLAN 10 e 20)
